NODE_ENV=development
PORT=5000
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://127.0.0.1:5500,http://localhost:5500,null
MAX_FILE_SIZE_MB=10

# Supabase project settings
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_anon_key

# Keep this secret. Use it only in this backend, never in frontend HTML.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Create this bucket in Supabase Storage and make it public for demo image viewing.
SUPABASE_STORAGE_BUCKET=construction-uploads
